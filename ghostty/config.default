# --- Font ---
# Nerd Font varianten zijn praktisch voor iconen in NERDTree, lightline etc.
# Installeer via: brew install --cask font-jetbrains-mono-nerd-font
#font-family = JetBrainsMono Nerd Font Mono
#font-family = Menlo
#font-family = SF Mono
font-family = Monaco
font-size = 15

# --- Theme ---
theme = Kitty Default

# --- Window ---
window-padding-x = 4
window-padding-y = 4
window-decoration = true
background-opacity = 0.95

# --- Cursor ---
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# --- Shell integration ---
shell-integration = zsh

# --- Clipboard ---
clipboard-read = allow
clipboard-write = allow
#copy-on-select = clipboard
copy-on-select = false

# --- Mouse ---
mouse-hide-while-typing = true

# --- Misc ----
# Zorg dat Option standaard leestekens typt (é, ç, ø, etc.)
macos-option-as-alt = false

# Woordspringen met pijltjestoetsen
keybind = alt+left=text:\x1bb
keybind = alt+right=text:\x1bf

# Woord vooruit verwijderen (Alt+D)
keybind = alt+d=text:\x1bd

# Woord achteruit springen (Alt+B - handig als alternatief voor pijltje)
keybind = alt+b=text:\x1bb

# Woord vooruit springen (Alt+F - handig als alternatief voor pijltje)
keybind = alt+f=text:\x1bf
macos-option-as-alt = false
