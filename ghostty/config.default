# --- Font ---
# Nerd Font varianten zijn praktisch voor iconen in NERDTree, lightline etc.
# Installeer via: brew install --cask font-jetbrains-mono-nerd-font
#font-family = JetBrainsMono Nerd Font Mono
#font-family = Menlo
#font-family = SF Mono
font-family = Monaco
font-size = 15

# --- Theme ---
theme = Kitty Default

# --- Window ---
window-padding-x = 4
window-padding-y = 4
window-decoration = true
background-opacity = 0.95

# --- Cursor ---
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# --- Shell integration ---
shell-integration = zsh

# --- Clipboard ---
clipboard-read = allow
clipboard-write = allow
#copy-on-select = clipboard
copy-on-select = false

# --- Mouse ---
mouse-hide-while-typing = true

# --- Misc ----
# Beide Option-toetsen als Alt/Meta (tmux M-h/j/k/l, woordspringen).
# Kost speciale tekens (é, ç, ø, ¬, ∆, …) via Option — geaccepteerd voor nu.
# Achtergrond: Ghostty kent geen left_alt/right_alt als keybind-modifier
# (zie https://ghostty.org/docs/config/keybind) en macos-option-as-alt = left
# is kapot in 1.3.1, ook met `alt`-keybinds als workaround: macOS's eigen
# dead-key-compositie (Option+h/j/k/l/…) verwerkt de toets al vóór Ghostty's
# keybind-matcher hem ziet, dus per-toets overschrijven werkt niet.
# Zie https://github.com/ghostty-org/ghostty/discussions/9511 (open, geen fix
# gemerged — PR #12787 is closed zonder merge).
macos-option-as-alt = true
