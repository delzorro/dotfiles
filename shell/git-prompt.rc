# Dependency-vrije __git_ps1: toont branch + dirty/untracked/upstream
# state in git-prompt-format (zelfde symbool-vocabulaire als git contrib).
# Gebruikt alleen `git` zelf — geen bash-completion/contrib nodig.
#
# Indicatoren:
#   *  unstaged changes
#   +  staged changes
#   %  untracked files
#   <  achter op upstream
#   >  vóór op upstream
#   <> divergerend
#   =  in sync met upstream

__git_ps1() {
    command -v git >/dev/null 2>&1 || return
    local branch
    branch=$(git symbolic-ref --short HEAD 2>/dev/null) \
        || branch=$(git rev-parse --short HEAD 2>/dev/null) \
        || return
    local marks=""
    git diff --no-ext-diff --quiet 2>/dev/null          || marks+="*"
    git diff --no-ext-diff --cached --quiet 2>/dev/null || marks+="+"
    [ -n "$(git ls-files --others --exclude-standard 2>/dev/null | head -1)" ] \
        && marks+="%"
    local upstream counts ahead behind
    if upstream=$(git rev-parse --abbrev-ref '@{u}' 2>/dev/null); then
        counts=$(git rev-list --left-right --count "@{u}...HEAD" 2>/dev/null)
        behind=${counts%%$'\t'*}; ahead=${counts##*$'\t'}
        if   [ "${behind:-0}" -gt 0 ] && [ "${ahead:-0}" -gt 0 ]; then marks+="<>"
        elif [ "${behind:-0}" -gt 0 ]; then marks+="<"
        elif [ "${ahead:-0}" -gt 0 ]; then marks+=">"
        else marks+="="
        fi
    fi
    printf -- "${1:- (%s)}" "${branch}${marks}"
}

# Safe wrapper: geeft lege string als __git_ps1 (nog) niet beschikbaar is.
__git_ps1_safe() {
    if command -v __git_ps1 >/dev/null 2>&1; then
        __git_ps1 "$@"
    fi
}
