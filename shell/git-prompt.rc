# Dependency-vrije __git_ps1: toont branch + dirty/untracked/upstream
# state in git-prompt-format (zelfde symbool-vocabulaire als git contrib).
# Gebruikt alleen `git` zelf — geen bash-completion/contrib nodig.
#
# Indicatoren:
#   *  unstaged changes
#   +  staged changes
#   %  untracked files
#   <  achter op upstream
#   >  vóór op upstream
#   <> divergerend
#   =  in sync met upstream

__git_ps1() {
    command -v git >/dev/null 2>&1 || return
    # Eén git-aanroep levert branch, upstream-status en alle markers;
    # --no-optional-locks: de prompt zet geen index.lock (botst niet met git in een andere pane)
    local line branch="" ab="" staged="" unstaged="" untracked=""
    while IFS= read -r line; do
        case $line in
            "# branch.head "*) branch=${line#\# branch.head } ;;
            "# branch.ab "*)   ab=${line#\# branch.ab } ;;
            "1 "*|"2 "*)
                if [ "${line:2:1}" != "." ]; then staged="+"; fi
                if [ "${line:3:1}" != "." ]; then unstaged="*"; fi ;;
            "u "*) staged="+"; unstaged="*" ;;
            "? "*) untracked="%" ;;
        esac
    done < <(git --no-optional-locks status --porcelain=v2 --branch 2>/dev/null)
    [ -n "$branch" ] || return
    if [ "$branch" = "(detached)" ]; then
        branch=$(git rev-parse --short HEAD 2>/dev/null) || return
    fi
    local marks="${unstaged}${staged}${untracked}"
    # branch.ab ("+ahead -behind") staat er alleen bij een geldige upstream
    if [ -n "$ab" ]; then
        local ahead=${ab%% *} behind=${ab##* }
        ahead=${ahead#+}; behind=${behind#-}
        if   [ "$behind" -gt 0 ] && [ "$ahead" -gt 0 ]; then marks+="<>"
        elif [ "$behind" -gt 0 ]; then marks+="<"
        elif [ "$ahead" -gt 0 ]; then marks+=">"
        else marks+="="
        fi
    fi
    local out
    out=$(printf -- "${1:- (%s)}" "${branch}${marks}")
    # zsh her-interpreteert % in een PROMPT_SUBST-substitutie als prompt-escape
    # (bv. de untracked-marker `%` zou `%)`/`%f` opeten → corrupte prompt +
    # doorlekkende kleur). Verdubbel daarom elke % tot %% — alleen onder zsh;
    # bash gebruikt letterlijke % in PS1 en mag niet ge-escaped worden.
    [ -n "${ZSH_VERSION:-}" ] && out=${out//\%/%%}
    printf '%s' "$out"
}
