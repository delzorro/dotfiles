# don't put duplicate lines in the history
setopt HIST_IGNORE_ALL_DUPS
# .. or lines starting with space in the history.
setopt HIST_IGNORE_SPACE

setopt APPEND_HISTORY
# Nieuwe regels direct wegschrijven en bij elke prompt inlezen uit andere actieve sessies
setopt SHARE_HISTORY

export HISTSIZE=100000
export SAVEHIST=$HISTSIZE

# Completion-systeem expliciet laden (anders alleen toevallig via gcloud's completion.zsh.inc in ~/.zshrc)
autoload -Uz compinit && compinit

# Command substitution in PROMPT toestaan (voor $(__git_ps1 ...))
setopt PROMPT_SUBST

# Prompt settings; mainly what I'm used to in bash, including a little extra
PROMPT='[%(?:%F{010}✔:%F{red}✗)%f]' # exit status last action
PROMPT+='%F{010}%n@%m%F{015}:' # user@machine
PROMPT+='%F{039}%(5~|%-1~/…/%3~|%4~)' # current directory (long paths trimmed)
PROMPT+='%F{yellow}$(__git_ps1 " (%s)")' # git branch + status (leeg buiten repo)
PROMPT+='%F{015}»%f ' # afsluitend prompt-teken

# PATH opnieuw opbouwen (zie shared.rc): /etc/zprofile heeft na .zshenv de systeemmappen vooraan gezet
shared_path

alias sudo='sudo '

# Laad de edit-command-line functie
autoload -U edit-command-line
zle -N edit-command-line

# Bind de functie aan een toets (bijv. Ctrl-x Ctrl-e)
bindkey '^x^e' edit-command-line
bindkey "^[[3~" delete-char
bindkey "^U" backward-kill-line
