# Make vim the default svn and git editor
export SVN_EDITOR="vim"
export GIT_EDITOR="vim"
export EDITOR="vim"

# Map vooraan in PATH, alleen als hij bestaat en er nog niet in staat
path_prepend() { [ -d "$1" ] || return 0; case ":$PATH:" in *":$1:"*) ;; *) PATH="$1:$PATH" ;; esac; }

# Homebrew — alleen toevoegen als aanwezig (macOS/Homebrew)
path_prepend /opt/homebrew/bin

# Java — alleen toevoegen als aanwezig (macOS/Homebrew)
path_prepend /opt/homebrew/opt/openjdk/bin

# NVM — lazy loading, alleen als installatie aanwezig
if [ -d "$HOME/.nvm" ]; then
  export NVM_DIR="$HOME/.nvm"
  # Default-versie direct in PATH, zodat globale npm-binaries (ng, tsc, …) werken zonder nvm.sh te laden
  [ -r "$NVM_DIR/alias/default" ] && { _nvm_v="$(<"$NVM_DIR/alias/default")"; _nvm_default_bin="$NVM_DIR/versions/node/v${_nvm_v#v}/bin"; }
  [ -n "${_nvm_default_bin:-}" ] && path_prepend "$_nvm_default_bin"
  unset _nvm_v _nvm_default_bin
fi

# Alles hieronder alleen voor interactieve shells; zsh laadt dit bestand ook voor `zsh -c` (via .zshenv)
case $- in
	*i*) ;;
	*) return ;;
esac

# make less more friendly for non-text input files, see lesspipe(1)
command -v lesspipe >/dev/null 2>&1 && eval "$(SHELL=/bin/sh lesspipe)"

# Load convenient aliases
[ -f ~/.files/shell/aliases ] && source ~/.files/shell/aliases

# Load git prompt helper (__git_ps1) plus GIT_PS1_* config
[ -f ~/.files/shell/git-prompt.rc ] && source ~/.files/shell/git-prompt.rc

if [ -n "${NVM_DIR:-}" ]; then
  nvm()  { unset -f nvm node npm npx; \. "$NVM_DIR/nvm.sh"; nvm  "$@"; }
  node() { unset -f nvm node npm npx; \. "$NVM_DIR/nvm.sh"; node "$@"; }
  npm()  { unset -f nvm node npm npx; \. "$NVM_DIR/nvm.sh"; npm  "$@"; }
  npx()  { unset -f nvm node npm npx; \. "$NVM_DIR/nvm.sh"; npx  "$@"; }
fi
