# ~/.bashrc: executed by bash(1) for non-login shells.
# see /usr/share/doc/bash/examples/startup-files (in the package bash-doc)
# for examples

# Stop when not running interactively
case $- in
    *i*) ;;
      *) return;;
esac

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=10000
HISTFILESIZE=10000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
#shopt -s globstar

# set a fancy prompt (non-color, unless we know we "want" color)
# setBashPromp moet vooraan (leest $?); daarna history delen met andere actieve sessies.
# Bestaande PROMPT_COMMAND van andere tools blijft behouden; guard voorkomt dubbel toevoegen bij opnieuw sourcen.
case "${PROMPT_COMMAND:-}" in
	*setBashPromp*) ;;
	*)
		_hist_share=""
		# bash 3.2 (macOS /bin/bash) verliest regels met `history -a; history -n`; daar alleen de prompt
		[ "${BASH_VERSINFO[0]}" -ge 4 ] && _hist_share="; history -a; history -n"
		PROMPT_COMMAND="setBashPromp${_hist_share}${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
		unset _hist_share
		;;
esac
# Function to set prompt including last command's exist status
function setBashPromp {
    local EXIT="$?"             # This needs to be first

    local resetCol='\[\e[0m\]'
    local redCol='\[\e[0;31m\]'
    local greenCol='\[\e[0;32m\]'
    local lightGreenCol='\[\e[0;92m\]'
    local boldBlueCol='\[\e[1;34m\]'
    local lightBlueCol='\[\e[0;94m\]'
	local boldYellowCol='\[\e[1;33m\]'
    local purpleColor='\[\e[0;35m\]'
	# Current PS1 configuration (git segment toegevoegd; leeg buiten repo's)
	PS1="${lightGreenCol}\u@\h:${boldBlueCol}\w${boldYellowCol}$(__git_ps1_safe ' (%s)')${resetCol}\$ "
	# Display whether last command's exit code was an error code
    if [ $EXIT != 0 ]; then
        PS1="[${redCol}✗${resetCol}]${PS1}"      
    else
        PS1="[${lightGreenCol}✔${resetCol}]${PS1}"
    fi
}

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  elif [ -r "${HOMEBREW_PREFIX:-/opt/homebrew}/etc/profile.d/bash_completion.sh" ]; then
    . "${HOMEBREW_PREFIX:-/opt/homebrew}/etc/profile.d/bash_completion.sh"
  fi
fi

# Set shell-mode to default / emacs (possible requirement for tmux)
set -o emacs

# Load shell indepenent settings
[ -f ~/.files/shell/shared.rc ] && source ~/.files/shell/shared.rc

# fzf initialisatie/configuratie
if command -v fzf >/dev/null 2>&1; then
	source ~/.files/fzf/bash
fi


