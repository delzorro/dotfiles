" nvim.markdown.configuration — markdown-specifieke setup voor nvim (render-markdown.nvim
" plugin-config). De markdown-kleuren staan in vimrc.markdown.shared (gedeeld met vim).
"
" Volgorde-eis (afgedwongen door WAAR dit gesourced wordt in nvimrc.plugin.configuration,
" niet door iets in dit bestand zelf): moet ná `call plug#end()` gesourced worden, anders
" bestaat de Lua-module 'render-markdown' nog niet en faalt de require hieronder stilletjes
" (pcall ok_rm = false). Zie nvimrc.plugin.configuration voor de exacte source-positie.

lua << EOF
  local ok_rm, rm = pcall(require, 'render-markdown')
  if ok_rm then
    rm.setup({
      heading = {
        icons = { '# ', '## ', '### ', '#### ', '##### ', '###### ' },
      },
      bullet = {
        -- niveau 1→4: van klein gevuld naar steeds subtieler
        icons = { '•', '◦', '▸', '·' },
      },
      code = {
        -- 'normal' = achtergrond op code blocks, geen language badge
        style = 'normal',
        highlight_inline = 'MarkdownInlineCode',
      },
      render_modes = true,
      win_options = {
        -- conceallevel 0: backticks + headings correct, bullets tonen als '-'
        conceallevel = { default = vim.o.conceallevel, rendered = 0 },
      },
    })
  end
EOF

" Instellingen gedeeld met vim (wrap e.d.)
source ~/.files/vim/vimrc.markdown.shared
