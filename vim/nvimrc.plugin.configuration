call plug#begin('~/.local/share/nvim/plugged')
source ~/.files/vim/vimrc.plugins.list
Plug 'nvim-treesitter/nvim-treesitter', { 'do': ':TSUpdate' }
Plug 'MeanderingProgrammer/render-markdown.nvim'
Plug 'folke/tokyonight.nvim'
call plug#end()

source ~/.files/vim/vimrc.plugins.shared

" =======================================================================
" treesitter setup (algemeen — parsers voor alle talen, niet markdown-specifiek)
" =======================================================================

lua << EOF
  local ok_ts, ts = pcall(require, 'nvim-treesitter.configs')
  if ok_ts then
    ts.setup({
      ensure_installed = {
        'markdown', 'markdown_inline',
        'javascript', 'typescript', 'tsx',
        'java', 'c_sharp',
        'bash', 'yaml', 'json', 'lua',
        'python', 'go', 'rust', 'css', 'html',
      },
      highlight = { enable = true },
    })
  end
EOF

" Markdown-specifieke highlighting + render-markdown.nvim setup: zie nvim.markdown.configuration.
" Moet hier staan — ná plug#end() hierboven (require('render-markdown') bestaat pas dan) en
" vóór 'colorscheme tokyonight-night' hieronder (die het ColorScheme-event afvuurt waarop de
" custom markdown-kleuren opnieuw toegepast moeten worden; de autocmd moet dus al geregistreerd
" zijn vóórdat colorscheme draait, anders overschrijft de colorscheme die kleuren juist).
source ~/.files/vim/nvim.markdown.configuration

colorscheme tokyonight-night

" Zwarte achtergrond + heldere body-tekst (geldt voor alle nvim buffers)
hi Normal      guibg=#000000 guifg=#edf0f8
hi NormalNC    guibg=#000000
hi NonText     guibg=#000000
hi EndOfBuffer guibg=#000000
hi LineNr      guibg=#000000
hi SignColumn  guibg=#000000
